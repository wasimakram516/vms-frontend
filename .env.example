# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# WebSocket Configuration
NEXT_PUBLIC_WEBSOCKET_HOST=http://localhost:4000

# Comma-separated CloudFront or S3 origins used for trusted uploaded media.
NEXT_PUBLIC_MEDIA_ORIGINS=

# Cloudflare Turnstile site key. Required in UAT and production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Node Environment
NEXT_PUBLIC_NODE_ENV=development
